# Google Cloud Console → API 和服務 → 憑證 → OAuth 2.0 用戶端 ID（網頁應用程式）
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 簽 session token 用的密鑰，產生方式：openssl rand -hex 32
JWT_SECRET=

# 允許呼叫 API 的前端網址，多個用逗號分隔（不要加結尾斜線、不要加路徑）
ALLOWED_ORIGIN=https://davidloman5.github.io,http://localhost:5173

PORT=8787
HOST=127.0.0.1
DB_PATH=./data.db
